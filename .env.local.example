# Tvůj Anthropic API klíč z console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Heslo, kterým appku zamkneš (ať ti na backendu nikdo neprojede kredit). Vyber si cokoliv.
APP_PASSWORD=zmen-me

# Supabase (pro sync Brainu + chatu napříč zařízeníma)
# Z tvého Supabase projektu: Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# !!! service_role klíč (NE anon) — tajnej, plnej přístup k DB. Nikdy do frontendu ani na GitHub. !!!
SUPABASE_SERVICE_ROLE_KEY=eyJ...
